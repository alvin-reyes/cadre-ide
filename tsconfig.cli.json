{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "target": "ES2021",
    "lib": ["ES2021"],
    "types": ["node"],
    "outDir": "dist-cli",
    "rootDir": "src",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "isolatedModules": false
  },
  "include": ["src/cli/cadre.ts", "src/cli/planning.ts"],
  "exclude": ["src/**/*.test.ts"]
}
